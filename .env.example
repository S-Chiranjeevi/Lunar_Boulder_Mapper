# MoonSafe environment configuration
# Copy to .env and fill in real values.

# ── Backend ───────────────────────────────────────────────────────────────────

# Path to a trained YOLOv8 .pt weight file.
# If empty or file not found, the backend runs in stub mode (zero detections).
MOONSAFE_MODEL_PATH=

# Host and port for the FastAPI server
MOONSAFE_HOST=0.0.0.0
MOONSAFE_PORT=8000

# ── Frontend ──────────────────────────────────────────────────────────────────
# The Vite dev server proxies /api to the backend automatically.
# For production builds set this to the backend base URL if serving separately.
VITE_API_BASE_URL=http://localhost:8000
