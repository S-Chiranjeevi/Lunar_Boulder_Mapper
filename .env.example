# Local storage for uploaded LRO NAC imagery and background job JSON records
MOONSAFE_DATA_DIR=./.moonsafe_data
MOONSAFE_HOST_DATA_DIR=./.moonsafe_data

# Optional path to trained YOLO boulder weights (.pt). Leave empty if not trained yet.
MOONSAFE_WEIGHTS_PATH=
MOONSAFE_HOST_MODELS_DIR=./models

# Comma-separated browser origins allowed to call the API from another host.
# Example: https://your-site.vercel.app,http://localhost:5173
MOONSAFE_CORS_ORIGINS=

# Exposed ports for local Docker Compose
API_PORT=8000
WEB_PORT=8080
